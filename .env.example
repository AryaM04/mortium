# Copy this file to .env. Fill in real values before you start the stack.
# Do not commit the .env file.

# Public domain name of the home server. Use "localhost" for local dev.
DOMAIN=localhost

# Port for the web app and reverse proxy.
WEB_PORT=8080

# Port for the API and gateway server.
API_PORT=3000

# Postgres database settings.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mortium
POSTGRES_USER=mortium
POSTGRES_PASSWORD=change-me

# Secret key for JWT access and refresh tokens. Use a long random value,
# at least 32 characters.
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more

# Origin of the web app. The server puts this value in email links and in
# the redirect after sign-in.
WEB_ORIGIN=http://localhost:5173

# Other origins that can call the API and open the gateway, as a comma
# list. Leave it empty to allow only WEB_ORIGIN. To use the desktop app
# with this server, add its origins:
#   Windows: http://tauri.localhost
#   macOS:   tauri://localhost
#   Linux:   app://mortium
# Example: CORS_ALLOWED_ORIGINS=http://tauri.localhost,tauri://localhost,app://mortium
CORS_ALLOWED_ORIGINS=

# The URL scheme of the desktop app. After an OAuth sign-in from the
# desktop app, the server sends the browser to "<scheme>://auth/callback".
# It must match plugins.deep-link in apps/desktop-tauri/src-tauri/tauri.conf.json
# and DEEP_LINK_SCHEME in apps/desktop-electron/src/shared/channels.ts.
DESKTOP_URL_SCHEME=mortium

# Directory for files the server keeps on disk, such as avatars.
DATA_DIR=./data

# Browser-visible origin of the API. The server builds OAuth redirect URIs
# from this value. It must match what the OAuth app registers.
PUBLIC_API_URL=http://localhost:5173

# Base rate limit for auth routes, in requests per minute per IP address.
# Some routes scale this value up or down. Raise it in a test environment
# to stop repeated test runs from hitting 429 errors. Default: 10.
AUTH_RATE_LIMIT_PER_MINUTE=10

# Set to true only to accept new plaintext (plain-v1) messages from old
# development clients. Keep it false: all clients encrypt their messages.
ALLOW_PLAINTEXT_EVENTS=false

# The largest encrypted attachment, in bytes (default 25 MiB).
MAX_ATTACHMENT_BYTES=26214400
# The total size of the attachments of one user, in bytes (default 2 GiB).
ATTACHMENT_QUOTA_BYTES=2147483648

# OAuth app credentials. Leave a pair empty to turn that provider off.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Shared secret for coturn use-auth-secret mode. Use a long random value.
TURN_SECRET=change-me-to-a-long-random-string

# TURN server address and ports.
TURN_DOMAIN=localhost
TURN_PORT=3478
TURN_TLS_PORT=5349
# The Opus voice bitrate in kbps (6 to 510). Each user sends one audio
# stream to each other user in the channel. With 10 users, 128 kbps
# uses about 1.2 Mbps of upload for each user.
VOICE_AUDIO_BITRATE_KBPS=128
# Host name that voice clients use to reach TURN. Leave empty to reuse
# TURN_DOMAIN.
TURN_PUBLIC_HOST=
# Set to "true" to also give clients a "turns:" (TURN over TLS) URL on
# TURN_TLS_PORT. Leave "false" when coturn has no TLS certificate.
TURN_TLS_ENABLED=false
# Relay ports. Keep them below 49152. On Windows, ports from 49152 are the
# dynamic range, and Hyper-V reserves blocks of it at random.
TURN_RELAY_MIN_PORT=40000
TURN_RELAY_MAX_PORT=40099

# Address that TURN relay candidates advertise to peers.
# Docker Desktop (Windows, macOS): "127.0.0.1" is correct for one machine.
# Docker on Linux: use the host IP address. 127.0.0.1 in the container is not the host.
# To test calls between two computers, use the host LAN address.
TURN_EXTERNAL_IP=127.0.0.1

# SMTP settings for account email (verification, password reset).
# SMTP_USER and SMTP_PASSWORD are optional. Leave them empty for a local
# server that needs no login, such as Mailpit.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Mortium <no-reply@example.com>"

# Mailpit web UI port (dev only, catches all outgoing mail).
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# The GitHub repository ("owner/name") whose latest release the download
# page (/download) shows. Leave it empty to turn the download route off.
RELEASES_REPO=AryaM04/mortium

# The GitHub repository ("owner/name") that scripts/auto-deploy.sh deploys
# from. Only the automatic updates use it (docs/deploy.md, section 7).
DEPLOY_REPO=AryaM04/mortium

# Optional: write the API server log to this file instead of standard
# output. Leave it empty for standard output.
LOG_FILE=

# ---------------------------------------------------------------------
# Production stack (docker-compose.yml). See docs/deploy.md.
# ---------------------------------------------------------------------
# The production stack sets these values itself, from DOMAIN. Do not set
# them for production: WEB_ORIGIN, PUBLIC_API_URL, POSTGRES_HOST,
# POSTGRES_PORT, API_PORT, DATA_DIR, TURN_DOMAIN, TURN_TLS_PORT.
# The values above that the stack reads from this file: DOMAIN,
# POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD, JWT_SECRET, TURN_SECRET,
# TURN_EXTERNAL_IP, TURN_PORT, TURN_PUBLIC_HOST, TURN_RELAY_MIN_PORT,
# TURN_RELAY_MAX_PORT, TURN_TLS_ENABLED, CORS_ALLOWED_ORIGINS, DESKTOP_URL_SCHEME, RELEASES_REPO,
# VOICE_AUDIO_BITRATE_KBPS, SMTP_*,
# the OAuth values, the rate limit and the attachment limits.
# Run "node scripts/generate-secrets.mjs" to make a .env file with new
# random secrets.

# How the stack receives web traffic. Use one of these values:
#   direct             Caddy gets a Let's Encrypt certificate and serves
#                      HTTPS on ports 80 and 443 of the host (default).
#   cloudflare-tunnel  A cloudflared tunnel on the host sends the traffic
#                      to Caddy. Caddy serves plain HTTP on HTTP_BIND.
#                      See docs/deploy.md, "Deploy behind a Cloudflare Tunnel".
# The start command is the same for the two modes: docker compose up -d
PROXY_MODE=direct

# Tunnel mode only: the host address and port for the plain HTTP listener
# of Caddy. Keep the address 127.0.0.1. Then only cloudflared on the host
# can send requests to it, and nobody can send a false client address.
HTTP_BIND=127.0.0.1:8480

# In production, coturn listens on TURN_PORT (UDP and TCP), and the API
# gives clients TURN URLs with TURN_PUBLIC_HOST and TURN_PORT. Change
# TURN_PORT when a different service on the host uses port 3478. Set
# TURN_PUBLIC_HOST when the TURN name is not DOMAIN. For example, a
# Cloudflare proxy or tunnel cannot carry TURN, so TURN needs its own
# DNS-only name. Set these values in the TURN section above.

# Email address for the Let's Encrypt certificate. Let's Encrypt sends
# expiry notices to this address. It is required in direct mode. Tunnel
# mode does not use it.
ACME_EMAIL=

# Certificate mode for Caddy. Leave it empty on a real server: Caddy gets a
# Let's Encrypt certificate. Set it to "internal" for a test on one
# machine: Caddy then uses its own test certificate authority.
TLS_MODE=

# Public IP address of the home network. TURN gives it to peers as the
# relay address. Behind a home router, write "PUBLIC_IP/LAN_IP", for
# example 203.0.113.7/192.168.1.20. The LAN_IP must be the address of the
# server. Write one address only when the server has the public IP address
# itself. This replaces the 127.0.0.1 value above.
# TURN_EXTERNAL_IP=

# Host folder for the backup files. Use a path on a different disk from the
# Docker volumes. The default is the "backups" folder in this folder.
# Container hardening. Keep this "true". Docker from the Ubuntu snap package
# cannot start a container with this flag (exec fails with "operation not
# permitted"). Only on such a host, set it to "false". The containers then
# still run without root, without capabilities and with read-only files.
NO_NEW_PRIVILEGES=true

BACKUP_DIR=./backups
# Number of days to keep the backup files.
BACKUP_KEEP_DAYS=14
# Optional: an age public key (it starts with "age1"). The backup service
# then encrypts each backup file to this key. Keep the private key on a
# different computer. See docs/deploy.md, step 9.
BACKUP_AGE_RECIPIENT=
# Hour of the day (0 to 23, in UTC) when the nightly backup starts.
BACKUP_HOUR=3

# Dynamic DNS with Cloudflare. Use it with: docker compose --profile ddns up -d
# The token needs the permission "Zone - DNS - Edit" for the zone of DOMAIN.
CLOUDFLARE_API_TOKEN=

# Dynamic DNS with DuckDNS. Use it with: docker compose --profile ddns-duckdns up -d
# Write only the part before ".duckdns.org" in DUCKDNS_SUBDOMAIN.
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=
